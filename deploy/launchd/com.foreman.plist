<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  launchd service definition for the foreman daemon (ARCHITECTURE.md §14).

  Install (as the dedicated `foreman` macOS user per ADR 0001 — see
  docs/adr/0001-orchestrator-hosting.md):

    cp deploy/launchd/com.foreman.plist ~/Library/LaunchAgents/
    launchctl load ~/Library/LaunchAgents/com.foreman.plist

  FOREMAN_HOME, TELEGRAM_BOT_TOKEN, and FOREMAN_GITHUB_TOKEN must already be set in this
  user's environment (e.g. via a launchd EnvironmentVariables plist override, or a wrapper
  script that sources the operator's uncommitted `.env` file — see the repo root's
  `.env_sample` — not committed to this repo) before loading — see
  specs/003-daemon-telegram-control/quickstart.md step 0.
-->
<plist version="1.0">
  <dict>
    <key>Label</key>
    <string>com.foreman</string>

    <key>ProgramArguments</key>
    <array>
      <string>/usr/local/bin/foreman</string>
    </array>

    <!-- Restart on crash or exit, but don't hot-loop if it fails immediately. -->
    <key>KeepAlive</key>
    <dict>
      <key>SuccessfulExit</key>
      <false/>
    </dict>
    <key>ThrottleInterval</key>
    <integer>10</integer>

    <!-- Start at login, not just on first manual load. -->
    <key>RunAtLoad</key>
    <true/>

    <key>StandardOutPath</key>
    <string>/tmp/foreman.out.log</string>
    <key>StandardErrorPath</key>
    <string>/tmp/foreman.err.log</string>

    <!-- SIGTERM on unload/shutdown, giving the daemon time to stop accepting new
         dispatch and let the reconciler recover the rest on next start (FR-010). -->
    <key>ExitTimeOut</key>
    <integer>30</integer>
  </dict>
</plist>
