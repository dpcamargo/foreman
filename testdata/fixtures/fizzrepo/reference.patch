+package fizzrepo
+
+import "strconv"
+
+// FizzBuzz returns "Fizz", "Buzz", "FizzBuzz" or n in decimal.
+func FizzBuzz(n int) string {
+	switch {
+	case n%15 == 0:
+		return "FizzBuzz"
+	case n%3 == 0:
+		return "Fizz"
+	case n%5 == 0:
+		return "Buzz"
+	}
+	return strconv.Itoa(n)
+}
