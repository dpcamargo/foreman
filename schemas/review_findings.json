{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ReviewFindings",
  "description": "Structured output from the cross-family review step in Feature 002 (FR-007)",
  "type": "object",
  "required": ["status", "summary", "findings"],
  "properties": {
    "status": {
      "type": "string",
      "enum": ["approved", "changes_requested"],
      "description": "Overall review recommendation"
    },
    "summary": {
      "type": "string",
      "description": "High-level assessment summary"
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["severity", "file", "message"],
        "properties": {
          "severity": {
            "type": "string",
            "enum": ["critical", "major", "minor", "advisory"]
          },
          "file": { "type": "string" },
          "line": { "type": "integer" },
          "message": { "type": "string" },
          "evidence": { "type": "string" },
          "repro": { "type": "string" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
