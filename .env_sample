# foreman daemon environment — copy to .env and fill in.
# .env is gitignored and must never be committed (AGENTS.md: no secrets in the repo).
# Load it into the daemon's environment however you prefer (launchd EnvironmentVariables
# override, a wrapper script that sources this file before exec'ing foreman, `launchctl
# setenv`, etc.) — do NOT read it from code and do NOT commit it.

# Required for the local API + daemon to run at all:
#   FOREMAN_HOME=/Users/you/.foreman

# Telegram control plane (optional — empty disables Telegram; the local API still runs).
# Get a token from @BotFather. REDACTED in all logs and reports.
# TELEGRAM_BOT_TOKEN=

# GitHub delivery/merge (optional — needed for US4, /deliver and /merge commands).
# Use a fine-grained PAT scoped to a single disposable test repo, never a broad one.
# FOREMAN_GITHUB_TOKEN=
# FOREMAN_GITHUB_OWNER=dpcamargo
# FOREMAN_GITHUB_REPO=foreman-test

# Secondary-channel ping for unanswered approvals (optional — empty disables it).
# One ntfy topic URL, e.g. https://ntfy.sh/foreman-approvals (spec.md Assumptions, T046).
# FOREMAN_NTFY_TOPIC_URL=

# Optional overrides (sensible defaults if unset):
# FOREMAN_DOCKER_CONTEXT=        # empty = current docker context
# FOREMAN_HERMES_HOME=           # default: ~/.hermes/profiles/foreman-arm
# FOREMAN_GRADER_IMAGE=          # default: pinned golang image digest (see cmd/foreman/env.go)
